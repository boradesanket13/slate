{
  "name": "slate",
  "version": "1.0.0",
  "description": "Slate: a free, browser-based studio that turns code snippets and screenshots into shareable images.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-monaco.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-monaco.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.cjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "assets:backgrounds": "node scripts/generate-backgrounds.mjs",
    "assets:examples": "node scripts/generate-assets.mjs",
    "assets:previews": "node scripts/capture-previews.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@sparticuz/chromium": "^153.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.575.0",
    "next": "^15.5.26",
    "puppeteer-core": "^25.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "react-icons": "^5.4.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "monaco-editor": {
      "dompurify": "3.4.17"
    },
    "postcss": {
      "source-map-js": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.17"
  },
  "author": "Sanket Borade <https://github.com/boradesanket13>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boradesanket13/slate.git"
  },
  "bugs": {
    "url": "https://github.com/boradesanket13/slate/issues"
  },
  "homepage": "https://github.com/boradesanket13/slate#readme"
}
